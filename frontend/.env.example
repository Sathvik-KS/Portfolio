# Frontend environment variables
# Copy this file to .env and fill in values as needed.

# GitHub username whose repositories are displayed on the portfolio
VITE_GITHUB_USERNAME=Sathvik-KS

# Optional GitHub personal access token for higher API rate limits
# Keep this secret — only needed if you exceed the 60 req/hour anonymous limit.
# VITE_GITHUB_TOKEN=

# Base URL of the Django REST API backend
VITE_API_BASE_URL=http://127.0.0.1:8000